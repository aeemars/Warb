# OpenRouter API Key (required)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Server port (default: 8080)
PORT=8080

# AI Model to use via OpenRouter (default: inclusionai/ling-3.0-flash-fin:free)
AI_MODEL=inclusionai/ling-3.0-flash-fin:free

# Database path (default: ./data/opportunity.db)
DB_PATH=./data/opportunity.db
